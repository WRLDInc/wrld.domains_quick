# WHMCS configuration.
# Locally, Pages Functions (`npm run cf:dev`) read these from `.dev.vars`,
# not `.env`: copy this file to `.dev.vars`. In production they are
# Cloudflare secrets on the Pages project.
WHMCS_URL=https://wrld.host
WHMCS_API_IDENTIFIER=your_api_identifier_here
WHMCS_API_SECRET=your_api_secret_here

# Environment
ENVIRONMENT=development

# Cloudflare Configuration (set via Wrangler)
# DOMAIN_ANALYTICS (KV Namespace - configured in wrangler.toml)
