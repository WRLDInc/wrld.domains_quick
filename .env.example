# Local secrets for the Worker. `npm run cf:dev` (wrangler dev) reads these
# from `.dev.vars`, not `.env`: copy this file to `.dev.vars`. In production
# they are secrets on the Worker (see DEPLOYMENT.md). Every integration is
# optional; leave a line out and that feature stays off.

# ---- Availability ------------------------------------------------------------
# Cloudflare Registrar (CF_ACCOUNT_ID is a var in wrangler.jsonc).
CF_REGISTRAR_API_TOKEN=
# WHMCS (WHMCS_URL is a var in wrangler.jsonc). The access key is
# $api_access_key from configuration.php; it lets the Worker past the WHMCS
# API IP allowlist.
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=
WHMCS_API_ACCESS_KEY=

# ---- AI suggestions ------------------------------------------------------------
ANTHROPIC_API_KEY=
# Without `wrangler login` the Workers AI binding can't connect locally; use
# the deterministic engine instead:
# SUGGEST_ENGINE=wordplay

# ---- WRLD Help wishlist -------------------------------------------------------
# Live Gleap workflow bot ID. Without it, wishlist actions open the standard
# WRLD Help flow with the selected domains attached as custom data.
# GLEAP_WISHLIST_BOT_ID=

# ---- Direct checkout (sandbox only locally) -------------------------------------
# CHECKOUT_MODE=both
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ORDER_WEBHOOK_URL=

ENVIRONMENT=development
